// GangNiaga AI - Autonomous Business Operating System
// Database Schema v4.0 — LivePlan x GangNiaga Enterprise Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE TABLES
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  avatar       String?
  role         String    @default("user") // user, admin, super_admin
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships     Membership[]
  chatSessions    ChatSession[]
  notifications   Notification[]
  agentSessions   AgentSession[]
  browserSessions BrowserSession[]
  exports         Export[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  industry  String?
  size      String? // startup, sme, enterprise
  country   String?
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  workspaces     Workspace[]
  plans          BusinessPlan[]
  forecasts      Forecast[]
  kpis           Kpi[]
  reports        Report[]
  workflows      Workflow[]
  subscriptions  Subscription[]
  exports        Export[]
  automationLogs AutomationLog[]
  integrations   Integration[]
  pipelines      AgentPipeline[]
  scheduledJobs  ScheduledJob[]
  rateLimitLogs  RateLimitLog[]

  @@map("organizations")
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           String    @default("viewer") // owner, admin, manager, accountant, viewer
  invitedAt      DateTime  @default(now())
  acceptedAt     DateTime?
  isActive       Boolean   @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ============================================
// AUTHENTICATION & SECURITY
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String // SHA-256 hash of the API key
  keyPrefix   String // First 8 chars for identification
  permissions String    @default("[]") // JSON array of permission strings
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String // e.g. "plan.create", "agent.execute", "workflow.run"
  resource       String // e.g. "business_plans", "agent_sessions", "workflows"
  resourceId     String?
  status         String   @default("success") // success, failure, denied
  ipAddress      String?
  userAgent      String?
  details        String? // JSON details of the action
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model RateLimitLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  endpoint       String
  method         String // GET, POST, etc.
  statusCode     Int      @default(200)
  responseTime   Int      @default(0) // ms
  tokenCount     Int      @default(0) // AI tokens consumed
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rate_limit_logs")
}

// ============================================
// BUSINESS PLAN BUILDER
// ============================================

model BusinessPlan {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("draft") // draft, review, approved, archived
  organizationId String
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     PlanSection[]

  @@map("business_plans")
}

model PlanSection {
  id          String   @id @default(cuid())
  planId      String
  type        String // executive_summary, market_analysis, swot, financial, competitor, team, marketing, operations
  title       String
  content     String   @default("")
  order       Int      @default(0)
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan BusinessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_sections")
}

// ============================================
// FINANCIAL FORECASTING
// ============================================

model Forecast {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("base") // best, base, worst, custom
  organizationId String
  startMonth     String // e.g. "2025-01"
  endMonth       String // e.g. "2026-12"
  currency       String   @default("USD")
  metadata       String   @default("{}") // JSON string for extra config
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revenueItems ForecastRevenue[]
  expenseItems ForecastExpense[]
  statements   FinancialStatement[]

  @@map("forecasts")
}

model ForecastRevenue {
  id         String  @id @default(cuid())
  forecastId String
  name       String
  category   String  @default("subscription") // subscription, transaction, service, product, other
  amount     Float   @default(0)
  growthRate Float   @default(0) // monthly growth percentage
  startMonth String
  endMonth   String?
  recurring  Boolean @default(true)
  metadata   String  @default("{}")
  order      Int     @default(0)

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@map("forecast_revenues")
}

model ForecastExpense {
  id         String  @id @default(cuid())
  forecastId String
  name       String
  category   String  @default("operational") // payroll, infrastructure, saas, tax, marketing, operational, other
  amount     Float   @default(0)
  growthRate Float   @default(0)
  startMonth String
  endMonth   String?
  recurring  Boolean @default(true)
  metadata   String  @default("{}")
  order      Int     @default(0)

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@map("forecast_expenses")
}

model FinancialStatement {
  id          String @id @default(cuid())
  forecastId  String
  month       String // "2025-01"
  type        String // pnl, balance_sheet, cash_flow
  revenue     Float  @default(0)
  expenses    Float  @default(0)
  netIncome   Float  @default(0)
  assets      Float  @default(0)
  liabilities Float  @default(0)
  equity      Float  @default(0)
  cashFlow    Float  @default(0)
  cashBalance Float  @default(0)
  burnRate    Float  @default(0)
  runway      Float  @default(0) // months
  metadata    String @default("{}")

  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@unique([forecastId, month, type])
  @@map("financial_statements")
}

// ============================================
// KPI INTELLIGENCE
// ============================================

model Kpi {
  id             String   @id @default(cuid())
  name           String
  category       String // revenue, growth, saas, cash, customer
  value          Float    @default(0)
  previousValue  Float    @default(0)
  target         Float?
  unit           String   @default("USD") // USD, percent, count
  period         String // "2025-01", "Q1-2025", "2025"
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("kpis")
}

// ============================================
// AI AGENT SYSTEM
// ============================================

model AgentSession {
  id        String   @id @default(cuid())
  userId    String
  agentType String // cfo, ceo, research, growth, operations, fundraising, browser, reporting
  title     String?
  status    String   @default("active") // active, completed, failed
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    AgentTask[]
  memories AgentMemory[]

  @@map("agent_sessions")
}

model AgentTask {
  id        String   @id @default(cuid())
  sessionId String
  type      String
  input     String
  output    String?
  status    String   @default("pending") // pending, running, completed, failed
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    AgentSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  executions ToolExecution[]

  @@map("agent_tasks")
}

model AgentMemory {
  id        String   @id @default(cuid())
  sessionId String
  type      String // user, workspace, agent, forecast, workflow
  key       String
  value     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("agent_memories")
}

model ToolExecution {
  id       String  @id @default(cuid())
  taskId   String
  tool     String // browser, email, forecast, pdf, crm, spreadsheet, analytics, web_search, code_execute
  input    String
  output   String?
  status   String  @default("pending") // pending, running, completed, failed
  duration Int? // ms
  metadata String  @default("{}")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("tool_executions")
}

// ============================================
// AGENT ORCHESTRATION (DAG PIPELINES)
// ============================================

model AgentPipeline {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  status         String   @default("draft") // draft, active, paused, archived
  triggerType    String   @default("manual") // manual, scheduled, event
  schedule       String? // cron expression
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        AgentPipelineStep[]
  runs         AgentPipelineRun[]

  @@map("agent_pipelines")
}

model AgentPipelineStep {
  id            String  @id @default(cuid())
  pipelineId    String
  agentType     String // cfo, ceo, research, growth, operations, fundraising, browser, reporting
  name          String
  description   String?
  inputTemplate String  @default("{}") // JSON template for agent input (can reference previous step outputs)
  config        String  @default("{}") // agent-specific config
  order         Int     @default(0)
  dependsOn     String  @default("[]") // JSON array of step IDs this step depends on
  isActive      Boolean @default(true)

  pipeline AgentPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("agent_pipeline_steps")
}

model AgentPipelineRun {
  id          String    @id @default(cuid())
  pipelineId  String
  status      String    @default("pending") // pending, running, completed, failed, cancelled
  triggeredBy String?
  result      String? // JSON summary of pipeline execution
  startedAt   DateTime?
  completedAt DateTime?
  metadata    String    @default("{}")
  createdAt   DateTime  @default(now())

  pipeline AgentPipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stepRuns PipelineStepRun[]

  @@map("agent_pipeline_runs")
}

model PipelineStepRun {
  id            String    @id @default(cuid())
  pipelineRunId String
  stepId        String
  agentType     String
  status        String    @default("pending") // pending, running, completed, failed, skipped
  input         String? // resolved input for this step
  output        String? // agent output
  error         String?
  duration      Int? // ms
  startedAt     DateTime?
  completedAt   DateTime?
  metadata      String    @default("{}")

  pipelineRun AgentPipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@map("pipeline_step_runs")
}

// ============================================
// MEMORY ARCHITECTURE (Global Memory Store)
// ============================================

model MemoryEntry {
  id             String    @id @default(cuid())
  organizationId String?
  userId         String?
  agentType      String? // which agent created this memory
  category       String // user_preference, workspace_context, agent_knowledge, forecast_insight, workflow_pattern, market_intelligence, financial_summary
  key            String
  value          String // the memory content
  summary        String? // compressed/summarized version
  relevanceScore Float     @default(1.0) // 0.0-1.0, used for ranking
  accessCount    Int       @default(0) // how many times this memory has been retrieved
  source         String    @default("agent") // agent, user, system, workflow, import
  tags           String    @default("[]") // JSON array of tags for categorization
  metadata       String    @default("{}")
  expiresAt      DateTime? // optional TTL
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("memory_entries")
}

// ============================================
// CHAT SYSTEM
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  agentType String? // general, cfo, ceo, research, growth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user, assistant, system
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ============================================
// WORKFLOW AUTOMATION
// ============================================

model Workflow {
  id             String   @id @default(cuid())
  name           String
  description    String?
  trigger        String // manual, scheduled, event
  schedule       String? // cron expression
  isActive       Boolean  @default(false)
  organizationId String
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  runs         WorkflowRun[]

  @@map("workflows")
}

model WorkflowStep {
  id         String  @id @default(cuid())
  workflowId String
  type       String // agent, tool, condition, delay, notification, pipeline
  name       String
  config     String  @default("{}")
  order      Int     @default(0)
  dependsOn  String  @default("[]") // JSON array of step IDs (DAG support)
  isActive   Boolean @default(true)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    @default("pending") // pending, running, completed, failed
  triggeredBy String?
  result      String?
  startedAt   DateTime?
  completedAt DateTime?
  metadata    String    @default("{}")
  createdAt   DateTime  @default(now())

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns WorkflowStepRun[]

  @@map("workflow_runs")
}

model WorkflowStepRun {
  id            String    @id @default(cuid())
  workflowRunId String
  stepId        String
  status        String    @default("pending") // pending, running, completed, failed, skipped
  input         String?
  output        String?
  error         String?
  duration      Int? // ms
  startedAt     DateTime?
  completedAt   DateTime?
  metadata      String    @default("{}")

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@map("workflow_step_runs")
}

// ============================================
// REPORTS
// ============================================

model Report {
  id             String   @id @default(cuid())
  title          String
  type           String // investor, board, kpi, financial, market
  format         String   @default("pdf") // pdf, docx, pptx, csv, xlsx
  status         String   @default("draft") // draft, generated, approved, sent
  content        String   @default("{}") // JSON
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, warning, error, success
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String
  plan               String    @default("free") // free, starter, pro, enterprise
  status             String    @default("active") // active, cancelled, past_due, trialing
  stripeCustomerId   String?
  stripePriceId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  metadata           String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ============================================
// EXPORTS
// ============================================

model Export {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String // plan, report, forecast, kpi
  format         String // pdf, docx, pptx, csv, xlsx, markdown
  title          String
  status         String   @default("pending") // pending, processing, completed, failed
  fileUrl        String?
  fileSize       Int?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("exports")
}

// ============================================
// BROWSER AUTOMATION
// ============================================

model BrowserSession {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("active") // active, completed, failed
  url       String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots BrowserSnapshot[]

  @@map("browser_sessions")
}

model BrowserSnapshot {
  id        String   @id @default(cuid())
  sessionId String
  type      String // screenshot, html, pdf, data
  url       String?
  data      String? // base64 or extracted data
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  session BrowserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("browser_snapshots")
}

// ============================================
// INTEGRATIONS
// ============================================

model Integration {
  id             String    @id @default(cuid())
  organizationId String
  type           String // quickbooks, xero, stripe, google_analytics, slack, discord, github, hubspot, salesforce
  name           String
  config         String    @default("{}") // encrypted config JSON
  status         String    @default("disconnected") // connected, disconnected, error
  lastSyncAt     DateTime?
  metadata       String    @default("{}")
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       IntegrationEvent[]

  @@map("integrations")
}

model IntegrationEvent {
  id            String    @id @default(cuid())
  integrationId String
  type          String // webhook, sync, action, error
  payload       String    @default("{}") // JSON payload
  status        String    @default("pending") // pending, processed, failed
  processedAt   DateTime?
  metadata      String    @default("{}")
  createdAt     DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("integration_events")
}

// ============================================
// SCHEDULED JOBS
// ============================================

model ScheduledJob {
  id             String    @id @default(cuid())
  organizationId String
  type           String // workflow, pipeline, report, browser_scan, sync
  name           String
  schedule       String // cron expression
  config         String    @default("{}") // JSON config for the job
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isActive       Boolean   @default(true)
  metadata       String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("scheduled_jobs")
}

// ============================================
// AUTOMATION LOGS
// ============================================

model AutomationLog {
  id             String   @id @default(cuid())
  organizationId String
  type           String // agent, workflow, browser, report, pipeline, integration, export
  action         String
  status         String   @default("success") // success, failure, warning
  details        String?
  userId         String?
  duration       Int? // ms
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("automation_logs")
}

// ============================================
// SKILL REGISTRY
// ============================================

model SkillRegistry {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String // tool, agent, integration
  category    String   @default("general") // browser, finance, communication, analytics, export, crm
  config      String   @default("{}")
  permissions String   @default("[]") // JSON array of required permissions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skill_registry")
}

// ============================================
// AGENT PERMISSIONS (RBAC for Agents)
// ============================================

model AgentPermission {
  id          String   @id @default(cuid())
  agentType   String // cfo, ceo, research, etc.
  resource    String // kpis, forecasts, plans, reports, workflows, integrations, browser, exports
  action      String // read, write, execute, admin
  isAllowed   Boolean  @default(false)
  constraints String   @default("{}") // JSON constraints (e.g. rate limits, allowed fields)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agentType, resource, action])
  @@map("agent_permissions")
}

// ============================================
// OBSERVABILITY & TOKEN TRACKING
// ============================================

model TokenUsage {
  id               String   @id @default(cuid())
  organizationId   String?
  userId           String?
  agentType        String?
  model            String   @default("default") // which LLM model was used
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  requestType      String // chat, plan_generate, forecast_analyze, report_generate, agent_task, pipeline_step
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())

  @@map("token_usage")
}

model ObservabilityEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  eventType      String // agent_execution, workflow_step, pipeline_step, browser_action, tool_execution, api_request
  source         String // which component generated this event
  status         String   @default("info") // info, warning, error, critical
  message        String
  data           String   @default("{}") // JSON event data
  traceId        String? // distributed tracing ID
  spanId         String? // span within a trace
  duration       Int? // ms
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@map("observability_events")
}

// ============================================
// IDEA CANVAS & VALIDATION ENGINE (v4.0)
// Pre-workflow idea pressure-testing system
// ============================================

model IdeaCanvas {
  id                   String   @id @default(cuid())
  userId               String
  organizationId       String
  title                String
  problem              String   @default("")
  solution             String   @default("")
  targetMarket         String   @default("")
  competitiveLandscape String   @default("")
  businessModel        String   @default("")
  uniqueValue          String   @default("")
  channels             String   @default("")
  costStructure        String   @default("")
  revenueStreams       String   @default("")
  riskAssessment       String   @default("{}") // JSON: { market_risk, tech_risk, financial_risk, team_risk }
  validationScore      Float    @default(0) // 0-100 aggregate score
  validationReport     String   @default("{}") // JSON structured report
  status               String   @default("draft") // draft, validating, validated, needs_rework, archived
  metadata             String   @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  validations IdeaValidation[]
  benchmarks  IdeaBenchmark[]

  @@map("idea_canvases")
}

model IdeaValidation {
  id         String   @id @default(cuid())
  canvasId   String
  category   String // market, financial, technical, competitive, team, regulatory
  question   String
  answer     String   @default("")
  riskLevel  String   @default("medium") // low, medium, high, critical
  score      Float    @default(0) // 0-100
  suggestion String? // AI-generated suggestion
  source     String? // where the assessment came from
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  canvas IdeaCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@map("idea_validations")
}

model IdeaBenchmark {
  id            String   @id @default(cuid())
  canvasId      String
  benchmarkType String // market_size, growth_rate, avg_revenue, customer_acquisition_cost, churn_rate, margin
  industry      String
  geography     String   @default("global") // my, sg, id, us, global
  value         Float    @default(0)
  unit          String   @default("USD") // USD, percent, count
  year          Int      @default(2024)
  source        String // name of data source
  sourceUrl     String? // URL for citation
  confidence    Float    @default(0.5) // 0-1 how reliable
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  canvas IdeaCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@map("idea_benchmarks")
}

// ============================================
// BANK-GRADE RESEARCH SYSTEM (v4.0)
// Verified sources, citations, industry benchmarks
// ============================================

model ResearchSource {
  id          String    @id @default(cuid())
  name        String
  type        String // government, industry_report, academic, financial_institution, news, database
  url         String?
  geography   String    @default("global") // my, sg, id, us, global, asean
  category    String // economic, industry, demographic, financial, regulatory, technology
  verified    Boolean   @default(false)
  rating      Float     @default(0) // 0-5 reliability rating
  lastUpdated DateTime?
  metadata    String    @default("{}")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  citations ResearchCitation[]

  @@map("research_sources")
}

model ResearchCitation {
  id             String   @id @default(cuid())
  sourceId       String
  sessionId      String? // agent session that produced this citation
  organizationId String?
  claim          String // the assertion being cited
  citation       String // the exact citation text
  dataPoint      String? // the specific data point referenced
  confidence     Float    @default(0.5) // 0-1
  verified       Boolean  @default(false)
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  source ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("research_citations")
}

model IndustryBenchmark {
  id           String   @id @default(cuid())
  industry     String // e.g. "saas", "fintech", "ecommerce", "healthcare"
  subIndustry  String? // e.g. "b2b_saas", "insurtech", "d2c_ecommerce"
  geography    String   @default("global")
  metric       String // e.g. "revenue_growth", "gross_margin", "churn_rate", "cac", "ltv"
  value        Float    @default(0)
  unit         String   @default("percent") // percent, USD, ratio, count
  period       String? // "2024", "Q1-2024"
  percentile25 Float?   @default(0) // 25th percentile
  percentile50 Float?   @default(0) // median
  percentile75 Float?   @default(0) // 75th percentile
  source       String // research firm name
  sourceUrl    String? // URL for verification
  sampleSize   Int? // number of companies in dataset
  confidence   Float    @default(0.7) // 0-1
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("industry_benchmarks")
}

// ============================================
// PLAN REVIEW AGENT — LENDER PERSONA (v4.0)
// Multi-agent plan review with narrative vs financial cross-check
// ============================================

model PlanReview {
  id               String   @id @default(cuid())
  planId           String
  organizationId   String
  reviewerType     String   @default("lender") // lender, investor, auditor, internal
  overallScore     Float    @default(0) // 0-100
  narrativeScore   Float    @default(0) // 0-100 quality of written narrative
  financialScore   Float    @default(0) // 0-100 quality of financial projections
  consistencyScore Float    @default(0) // 0-100 narrative vs financial alignment
  riskScore        Float    @default(0) // 0-100 risk assessment
  fundabilityScore Float    @default(0) // 0-100 likelihood of getting funded
  summary          String   @default("") // AI-generated executive summary of review
  discrepancies    String   @default("[]") // JSON array of narrative vs financial mismatches
  recommendations  String   @default("[]") // JSON array of improvement suggestions
  redFlags         String   @default("[]") // JSON array of critical issues
  strengths        String   @default("[]") // JSON array of plan strengths
  status           String   @default("pending") // pending, reviewing, completed, needs_revision
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  findings PlanReviewFinding[]

  @@map("plan_reviews")
}

model PlanReviewFinding {
  id           String   @id @default(cuid())
  reviewId     String
  type         String // discrepancy, red_flag, strength, recommendation, data_gap
  severity     String   @default("medium") // info, low, medium, high, critical
  section      String // which plan section this refers to
  description  String
  evidence     String? // supporting data/evidence
  suggestion   String? // how to fix/improve
  narrativeRef String? // reference to narrative text
  financialRef String? // reference to financial data point
  resolved     Boolean  @default(false)
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  review PlanReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("plan_review_findings")
}

// ============================================
// LIVE PLAN VS ACTUALS TRACKING (v4.0)
// QuickBooks/Xero integration, real-time variance analysis
// ============================================

model ActualFinancial {
  id                 String   @id @default(cuid())
  organizationId     String
  period             String // "2025-01", "Q1-2025"
  source             String // quickbooks, xero, manual, csv_import
  sourceSyncId       String? // ID from the accounting software
  revenue            Float    @default(0)
  cogs               Float    @default(0)
  grossProfit        Float    @default(0)
  operatingExpenses  Float    @default(0)
  netIncome          Float    @default(0)
  cashFlow           Float    @default(0)
  cashBalance        Float    @default(0)
  accountsReceivable Float    @default(0)
  accountsPayable    Float    @default(0)
  totalAssets        Float    @default(0)
  totalLiabilities   Float    @default(0)
  equity             Float    @default(0)
  burnRate           Float    @default(0)
  runway             Float    @default(0)
  lineItems          String   @default("{}") // JSON: detailed breakdown
  metadata           String   @default("{}")
  importedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([organizationId, period, source])
  @@map("actual_financials")
}

model ForecastVariance {
  id              String   @id @default(cuid())
  organizationId  String
  forecastId      String?
  period          String // "2025-01"
  metric          String // revenue, cogs, gross_profit, operating_expenses, net_income, cash_flow, burn_rate
  forecastValue   Float    @default(0)
  actualValue     Float    @default(0)
  variance        Float    @default(0) // absolute variance
  variancePercent Float    @default(0) // percentage variance
  alertLevel      String   @default("on_track") // on_track, warning, critical, exceeded
  analysis        String? // AI-generated explanation
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  @@unique([organizationId, forecastId, period, metric])
  @@map("forecast_variances")
}

model FinancialAlert {
  id             String    @id @default(cuid())
  organizationId String
  type           String // revenue_tracking, expense_drift, cash_warning, hiring_affordability, milestone, variance_threshold
  metric         String
  message        String
  severity       String    @default("info") // info, warning, critical
  period         String? // which period this alert refers to
  data           String    @default("{}") // JSON: supporting data
  dismissed      Boolean   @default(false)
  dismissedAt    DateTime?
  actionTaken    String?
  createdAt      DateTime  @default(now())

  @@map("financial_alerts")
}

model AccountingConnection {
  id             String    @id @default(cuid())
  organizationId String
  provider       String // quickbooks, xero
  status         String    @default("disconnected") // connected, disconnected, expired, error
  accessToken    String? // encrypted OAuth access token
  refreshToken   String? // encrypted OAuth refresh token
  tokenExpiresAt DateTime?
  companyId      String? // realmId for QB, tenant ID for Xero
  companyName    String?
  lastSyncAt     DateTime?
  syncFrequency  String    @default("daily") // hourly, daily, weekly, monthly
  syncStartDate  String? // how far back to pull data
  scopes         String    @default("[]") // JSON: granted OAuth scopes
  metadata       String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, provider])
  @@map("accounting_connections")
}

// ============================================
// DYNAMIC PITCH DECK ORCHESTRATOR (v4.0)
// Auto-synced investor presentations with dynamic variables
// ============================================

model PitchDeck {
  id               String   @id @default(cuid())
  organizationId   String
  planId           String?
  title            String
  templateId       String? // which template was used
  status           String   @default("draft") // draft, generating, ready, presented, archived
  slides           String   @default("[]") // JSON: ordered slide IDs
  dynamicVariables String   @default("{}") // JSON: { variable_name: value } auto-synced
  totalSlides      Int      @default(0)
  fundingAsk       Float? // how much being raised
  useOfFunds       String? // JSON breakdown
  targetAudience   String   @default("investor") // investor, lender, partner, internal
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slideData PitchDeckSlide[]
  questions PitchDeckQuestion[]

  @@map("pitch_decks")
}

model PitchDeckSlide {
  id            String   @id @default(cuid())
  deckId        String
  order         Int      @default(0)
  type          String // title, problem, solution, market, product, business_model, traction, team, financials, ask, appendix
  title         String
  content       String   @default("{}") // JSON: structured slide content
  layout        String   @default("default") // default, centered, split, data_heavy, visual
  dataSource    String? // JSON: reference to plan/forecast data source
  dynamicFields String   @default("[]") // JSON: fields that auto-update from financial data
  speakerNotes  String?
  imageUrl      String? // generated or uploaded image
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deck PitchDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("pitch_deck_slides")
}

model PitchDeckQuestion {
  id              String   @id @default(cuid())
  deckId          String
  question        String
  category        String // financial, market, team, product, competition, risk, terms
  suggestedAnswer String? // AI-generated response
  likelihood      String   @default("medium") // low, medium, high
  difficulty      String   @default("medium") // easy, medium, hard
  slideReference  String? // which slide this question relates to
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  deck PitchDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("pitch_deck_questions")
}

model PitchDeckTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String // seed, series_a, series_b, debt, partner, internal
  slideCount  Int      @default(0)
  slides      String   @default("[]") // JSON: template slide definitions
  thumbnail   String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pitch_deck_templates")
}
